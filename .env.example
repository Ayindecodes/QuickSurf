# Local development settings. Copy to .env:  cp .env.example .env
# (Production uses .env.production.example instead.)
ENV=development
DEBUG=True
SECRET_KEY=dev-only-change-me

# SANDBOX talks to sandbox.vtpass.com. Never put LIVE keys in a development .env.
PROVIDER_MODE=SANDBOX
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Paystack test-mode keys (sk_test_... / pk_test_...)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/callback

FRONTEND_URL=http://localhost:3000
