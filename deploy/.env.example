# QuickSurf API, self-hosted. Copy to deploy/.env (chmod 600) and fill in. Never commit deploy/.env.
# Any other setting from ../.env.production.example can be added here too.

# --- This server ---
# The API's hostname (DNS A/AAAA record pointing at this server). Caddy gets its HTTPS certificate.
# No domain yet? A free name from duckdns.org works, e.g. quicksurf.duckdns.org (see deploy/README.md).
API_DOMAIN=api.example.com
# Let's Encrypt expiry notices
ACME_EMAIL=you@example.com
# Database password (the database is only reachable inside Docker). e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=
# Ports Caddy listens on (keep 80/443 in production)
HTTP_PORT=80
HTTPS_PORT=443

# --- Django ---
ENV=production
DEBUG=False
# At least 50 random characters, e.g. `openssl rand -base64 60 | tr -d '\n'`
SECRET_KEY=
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOW_ALL_ORIGINS=False
# The frontend's origin: the only browser origin allowed to call the API
FRONTEND_URL=https://www.example.com
SECURE_HSTS_PRELOAD=True
LOG_FORMAT=json
# Something unguessable, e.g. ops-7f3k2q/
ADMIN_URL=
STAFF_MFA_REQUIRED=True
# Requests handled at once = WEB_CONCURRENCY x GUNICORN_THREADS (see docs/load-testing.md)
WEB_CONCURRENCY=2
GUNICORN_THREADS=8

# --- Providers ---
PROVIDER_MODE=LIVE
VTPASS_BASE_URL=https://vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Leave empty: Paystack signs webhooks with the secret key above
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://www.example.com/dashboard/topup/callback

# --- Email (codes, receipts, alerts) ---
# No domain yet? A Gmail account with an app password works: EMAIL_HOST=smtp.gmail.com (see deploy/README.md)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Monitoring ---
OPS_ALERT_EMAILS=
SENTRY_DSN=

# --- Kill switches and limits (soft-launch values: docs/LAUNCH.md) ---
PURCHASES_ENABLED=True
TOPUPS_ENABLED=True
AIRTIME_MAX_AMOUNT=5000
TOPUP_MAX_AMOUNT=20000
DAILY_PURCHASE_LIMIT=20000
NEW_ACCOUNT_DAILY_LIMIT=5000
PURCHASE_RATE=15/hour
TOPUP_RATE=5/hour

# --- Verification levels and fraud checks (users/limits.py, users/risk.py) ---
# Text messages: "termii" in production. Get the key and an approved sender ID from termii.com.
SMS_BACKEND=termii
TERMII_API_KEY=
TERMII_SENDER_ID=QuickSurf
# Your account's base URL is shown in the Termii dashboard
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd
# Require a verified phone before topping up (turn on once texts arrive)
TOPUP_REQUIRES_PHONE=False
# Daily limits for accounts with only an email confirmed (phone-verified accounts get the full limits)
BASIC_DAILY_PURCHASE_LIMIT=10000
BASIC_DAILY_TOPUP_LIMIT=10000
DAILY_TOPUP_LIMIT=500000
# Flag an account when one card has funded more than this many accounts, or one device signed in to more
CARD_MAX_ACCOUNTS=2
DEVICE_MAX_ACCOUNTS=3

# --- Backups (deploy/backup) ---
# The age PUBLIC key backups are encrypted to (`age-keygen -o quicksurf-backup.key` on YOUR computer; the
# line starting "age1..."). The private key never goes on this server, so a stolen backup can't be read.
BACKUP_AGE_RECIPIENT=
# When to back up (hour, UTC) and how many days of copies to keep on this server
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=14
# Off-server copy with rclone, e.g. "offsite:quicksurf-backups". Configure the remote with RCLONE_CONFIG_* vars,
# e.g. for Cloudflare R2 / Backblaze B2 / AWS S3 (any S3-compatible storage):
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
# Optional dead-man's switch (e.g. healthchecks.io): pinged after every backup, alerts you if one is missed
BACKUP_PING_URL=
