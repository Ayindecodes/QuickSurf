# --- Environment ---
ENV=production
DEBUG=False
SECRET_KEY=replace-with-strong-secret

# --- Hosts ---
ALLOWED_HOSTS=quicksurf.onrender.com
CSRF_TRUSTED_ORIGINS=https://quicksurf.onrender.com
CORS_ALLOWED_ORIGINS=https://quicksurf.onrender.com
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=https://your-frontend.onrender.com

# --- Infrastructure ---
DB_SSL_REQUIRE=True
REDIS_URL=rediss://default:password@host:6379
SECURE_HSTS_PRELOAD=True

# --- Providers ---
PROVIDER_MODE=LIVE
VTPASS_BASE_URL=https://vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://your-frontend.example.com/dashboard/topup/callback

# --- App ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@quicksurf.app
# SMTP from your email provider (verification and password reset codes depend on it)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DRF_USER_THROTTLE=1000/day
DRF_ANON_THROTTLE=100/day
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
POINTS_PER_NAIRA=0.01
REWARDS_ENABLED=True
# Naira credited per point redeemed, and the fewest points that can be redeemed at once
REWARD_POINT_VALUE=1.00
REWARDS_MIN_REDEMPTION=100
RECEIPT_EMAILS_ENABLED=True

# --- Kill switches (set to False to stop new purchases / top-ups) ---
PURCHASES_ENABLED=True
TOPUPS_ENABLED=True

# --- Purchase rules (naira) ---
AIRTIME_MIN_AMOUNT=50
AIRTIME_MAX_AMOUNT=50000
TOPUP_MAX_AMOUNT=500000
DAILY_PURCHASE_LIMIT=200000
DATA_PRICE_MARKUP_PERCENT=0
NEW_ACCOUNT_DAILY_LIMIT=20000
PURCHASE_RATE=30/hour
TOPUP_RATE=20/hour
# Purchases need the 4-digit PIN; set False only until the frontend has a PIN screen
TRANSACTION_PIN_REQUIRED=True

# --- Verification levels and fraud checks (users/limits.py, users/risk.py) ---
# Text messages: "termii" in production. Get the key and an approved sender ID from termii.com.
SMS_BACKEND=termii
TERMII_API_KEY=
TERMII_SENDER_ID=QuickSurf
# Your account's base URL is shown in the Termii dashboard
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd
# Require a verified phone before topping up (turn on once texts arrive)
TOPUP_REQUIRES_PHONE=False
# Daily limits for accounts with only an email confirmed (phone-verified accounts get the full limits)
BASIC_DAILY_PURCHASE_LIMIT=10000
BASIC_DAILY_TOPUP_LIMIT=10000
DAILY_TOPUP_LIMIT=500000
# Flag an account when one card has funded more than this many accounts, or one device signed in to more
CARD_MAX_ACCOUNTS=2
DEVICE_MAX_ACCOUNTS=3

# --- Admin ---
# Something unguessable, e.g. ops-7f3k2q/
ADMIN_URL=admin/
STAFF_MFA_REQUIRED=True

# --- Monitoring ---
# Comma-separated emails for ops alerts and the daily report
OPS_ALERT_EMAILS=
# Error tracking (optional)
SENTRY_DSN=
LOG_FORMAT=json

# --- Proxy ---
# Header carrying the real client IP: CF-Connecting-IP on Render (Cloudflare), X-Real-IP when self-hosted (deploy/)
CLIENT_IP_HEADER=CF-Connecting-IP
